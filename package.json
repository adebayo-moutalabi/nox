{
  "name": "nox-desktop",
  "version": "1.1.0",
  "description": "Mascotte de bureau anti-procrastination (TDAH et au-dela)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/e2e.js && node tests/e2e-en.js",
    "icon": "node tools/icon.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "imapflow": "^1.0.164",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.48.2"
  },
  "build": {
    "appId": "com.rekj.nox",
    "productName": "Nox",
    "copyright": "Habib Moutalabi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!.env",
      "!.env.*",
      "!tests/**",
      "!docs/**",
      "!tools/**",
      "!dist/**",
      "!*.md",
      "!.gitattributes"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nox"
    }
  }
}
